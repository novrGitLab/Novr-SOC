# NovrSOC V2 VMS worker adapter (v2_adapter.py): DEVELOPMENT settings for running it on a local host.
# Production runs the image on Server 2 (compose service vms-worker, profile "vms"); its settings are fixed in
# deploy/server2/compose.yaml (gate G-B in docs/public/DEPLOYMENT.md). Names and non-secret values only in Git.
#   set -a; . ./v2-adapter.env; set +a; python v2_adapter.py --once
# A local development API (plain http only for loopback).
NOVRSOC_API_URL=http://127.0.0.1:8000
# NOVRSOC_API_CA_CERT=<path to the CA that signed the API certificate, for an https API>
# One organization-bound vms_worker credential (nsk_...) per file, issued once with
# `python -m app.cli create-service-identity --kind vms_worker --scope vms:worker ...`. Mode 0400.
NOVRSOC_VMS_TOKEN_FILE=<path to the vms_worker token file>
# or: NOVRSOC_VMS_TOKEN_DIR=<directory of <org-slug>.token files>
# disabled (default: heartbeat only) | tcp_connect | greenbone_report | nmap_service. tcp_connect and greenbone_report
# touch only local test targets (loopback, *.test, *.localhost). nmap_service is the production engine: it needs the API
# in authorized_scopes mode, the organization's enabled scan policy, nmap on this host (image vms-scanner.Dockerfile) and
# VMS_ALLOWED_NETWORKS; anything outside those networks, or inside a protected network, is reported and never probed.
VMS_ENGINE=disabled
# VMS_TCP_PORTS=22,80,443
# VMS_GREENBONE_REPORT=<path to a Greenbone GMP report file, for VMS_ENGINE=greenbone_report>
# nmap_service only:
# VMS_ALLOWED_NETWORKS=<the client networks THIS host has a route to, comma CIDRs, e.g. 10.20.0.0/24>
# VMS_NMAP_MAX_RATE=100          # packets/s ceiling of this host (the policy's ceiling applies when lower)
# VMS_NMAP_PORTS=top-1000        # or an nmap port list, e.g. 22,80,443,8000-8100
# VMS_NMAP_HOST_TIMEOUT=30m
