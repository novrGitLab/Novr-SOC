# NovrSOC V2 VMS worker adapter (v2_adapter.py), on the OWNER'S LOCAL HOST only, never on Server 1 or Server 2.
# Names and non-secret values only in Git. Gate G-B in docs/public/DEPLOYMENT.md.
#   set -a; . ./v2-adapter.env; set +a; python v2_adapter.py --once
# The V2 API on Server 2, reached over WireGuard / the owner's VPN (NGINX admits /api/v1/vms/worker/ only from there).
NOVRSOC_API_URL=https://<api name on WireGuard>
NOVRSOC_API_CA_CERT=<path to the CA that signed the API certificate>
# The organization-bound vms_worker credential (nsk_...), issued once from Tenants and users -> machine identities.
# File mode 0400, owned by the user running the adapter.
NOVRSOC_VMS_TOKEN_FILE=<path to the vms_worker token file>
# Engines are restricted to local test targets (loopback, *.test, *.localhost); production scanning stays disabled on
# the API (NOVRSOC_VMS_SCANNING=disabled) until a production mode is approved (gate G-B).
VMS_ENGINE=tcp_connect
VMS_TCP_PORTS=22,80,443
# VMS_GREENBONE_REPORT=<path to a Greenbone GMP report file, for VMS_ENGINE=greenbone_report>
