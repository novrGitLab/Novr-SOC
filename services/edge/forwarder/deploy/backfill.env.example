# /etc/novrsoc-backfill/backfill.env  (mode 0640, root:novrsoc-backfill). NAMES ONLY here: no values in Git.
# The historical backfill is NOT the live forwarder: its own install directory, user, credential and state directory.
# Secrets are read from files (mode 0400, owner novrsoc-backfill), never from this file.

# NovrSOC API (Server 2, over the private WireGuard network; https only, certificate verified)
NOVRSOC_API_URL=https://<api-private-name>:<port>
NOVRSOC_API_CA_CERT=/etc/novrsoc-backfill/api-ca.pem
# A SEPARATE platform forwarder identity (e.g. server1-backfill), revocable without touching the live forwarder
NOVRSOC_BACKFILL_TOKEN_FILE=/etc/novrsoc-backfill/backfill.token

# Wazuh indexer and manager on this host (the same read-only users as the forwarder are fine; read-only access only)
WAZUH_INDEXER_URL=https://<indexer-name>:9200
WAZUH_INDEXER_CA_CERT=/etc/novrsoc-backfill/wazuh-root-ca.pem
WAZUH_INDEXER_USER=novrsoc_forwarder_ro
WAZUH_INDEXER_PASSWORD_FILE=/etc/novrsoc-backfill/indexer.password
WAZUH_ALERTS_INDEX=wazuh-alerts-4.x-*
WAZUH_API_URL=https://<manager-name>:55000
WAZUH_API_CA_CERT=/etc/novrsoc-backfill/wazuh-api-ca.pem
WAZUH_API_USER=novrsoc_forwarder_ro
WAZUH_API_PASSWORD_FILE=/etc/novrsoc-backfill/manager.password

# Its own state (plan progress, ledger, dead letters). NEVER the live forwarder's directory: the tool refuses a directory
# that holds cursor.json or forwarder.lock, and the one named in FORWARDER_STATE_DIR.
BACKFILL_STATE_DIR=/var/lib/novrsoc-backfill
FORWARDER_STATE_DIR=/var/lib/novrsoc-forwarder

# Tuning (defaults shown)
BACKFILL_PAGE_SIZE=100
BACKFILL_MIN_LEVEL=0
BACKFILL_SETTLE_SECONDS=300
BACKFILL_HTTP_TIMEOUT_SECONDS=60
BACKFILL_MAX_RETRIES=6
