# /etc/novrsoc-forwarder/forwarder.env  (mode 0640, root:novrsoc-forwarder). NAMES ONLY here: no values in Git.
# Secrets are read from files (mode 0400, owner novrsoc-forwarder), never from this file.

# NovrSOC API (Server 2, over the private WireGuard network; https only, certificate verified)
NOVRSOC_API_URL=https://<api-private-name>:<port>
NOVRSOC_API_CA_CERT=/etc/novrsoc-forwarder/api-ca.pem
NOVRSOC_FORWARDER_TOKEN_FILE=/etc/novrsoc-forwarder/forwarder.token

# Wazuh indexer and manager on this host (read-only users; the certificate must name the host used in the URL)
WAZUH_INDEXER_URL=https://<indexer-name>:9200
WAZUH_INDEXER_CA_CERT=/etc/novrsoc-forwarder/wazuh-root-ca.pem
WAZUH_INDEXER_USER=novrsoc_forwarder_ro
WAZUH_INDEXER_PASSWORD_FILE=/etc/novrsoc-forwarder/indexer.password
WAZUH_ALERTS_INDEX=wazuh-alerts-4.x-*
WAZUH_API_URL=https://<manager-name>:55000
WAZUH_API_CA_CERT=/etc/novrsoc-forwarder/wazuh-api-ca.pem
WAZUH_API_USER=novrsoc_forwarder_ro
WAZUH_API_PASSWORD_FILE=/etc/novrsoc-forwarder/manager.password

# State (systemd StateDirectory)
FORWARDER_STATE_DIR=/var/lib/novrsoc-forwarder
# First run only (ignored once cursor.json exists): "now", or the timestamp recorded when the legacy forwarder was
# stopped (its backed-up ingest_cursor.json), so nothing between the two is skipped. Never earlier than needed.
FORWARDER_START_AT=<ISO timestamp from the legacy cursor backup>

# Tuning (defaults shown)
FORWARDER_INTERVAL_SECONDS=30
FORWARDER_BATCH=100
FORWARDER_SETTLE_SECONDS=60
FORWARDER_OVERLAP_SECONDS=120
FORWARDER_LATE_EVERY=10
FORWARDER_LATE_MAX_PAGES=5
FORWARDER_MIN_LEVEL=0
FORWARDER_HTTP_TIMEOUT_SECONDS=30
FORWARDER_GROUP_CACHE_SECONDS=300
FORWARDER_GROUP_MAX_STALE_SECONDS=3600
