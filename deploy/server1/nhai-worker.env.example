# /etc/novrsoc-nhai/nhai-worker.env (mode 0640, root:novrsoc-nhai). NAMES and non-secret values only in Git.
NOVRSOC_ENV=production
# PostgreSQL on Server 2 over WireGuard, as the dedicated least-privilege role novrsoc_nhai (grants: migration
# 0016_nhai_worker_role; login enabled at gate G-F2), TLS required. Never the API's role.
NOVRSOC_DATABASE_URL=postgresql+psycopg://novrsoc_nhai:<password>@<server2-wireguard-address>:5432/novrsoc?sslmode=verify-full&sslrootcert=/etc/novrsoc-nhai/db-ca.pem
NOVRSOC_PRODUCTION_DATABASE_HOSTS=<server2-wireguard-address>
NOVRSOC_SESSION_COOKIE_SECURE=true

# Inference: local Ollama on this host, loopback only (plain HTTP is accepted only for 127.0.0.1 / ::1).
NOVRSOC_NHAI_BACKEND=ollama
NOVRSOC_NHAI_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300

# CPU-only sizing from the Server 1 benchmarks (212 tokens in 80.82 s, ~2.6 tokens/s): one job at a time,
# at most 384 output tokens (~150 s), a 300 s inference timeout, a 30-minute job deadline.
NOVRSOC_NHAI_INFERENCE_TIMEOUT_SECONDS=300
NOVRSOC_NHAI_MAX_OUTPUT_TOKENS=384
NOVRSOC_NHAI_MAX_PROMPT_CHARS=12000
NOVRSOC_NHAI_JOB_DEADLINE_SECONDS=1800
# Context window (tokens). The worker refuses to start when the largest admitted prompt plus the answer does not fit
# (Ollama would silently drop the start of the prompt). Check on this host: python -m app.nhai.diagnose --db
NOVRSOC_NHAI_NUM_CTX=8192
