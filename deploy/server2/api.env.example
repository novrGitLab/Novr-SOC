# ${NOVRSOC_CONFIG_DIR}/api.env (default /etc/novrsoc-v2/api.env), mode 0600 root:root. Read by Docker for the api
# service. NAMES and non-secret values only in Git; every <...> is filled on the server, never committed.
NOVRSOC_ENV=production
# The API's runtime role (row-level security applies). Host "postgres" is the compose service on the internal network.
NOVRSOC_DATABASE_URL=postgresql+psycopg://novrsoc_app:<pg_app_password>@postgres:5432/novrsoc
NOVRSOC_PRODUCTION_DATABASE_HOSTS=postgres
NOVRSOC_SESSION_COOKIE_SECURE=true
NOVRSOC_DOCS_ENABLED=false

# Wazuh on Server 1 over WireGuard (read-only). Keep unconfigured until gate G-C1 (docs/public/DEPLOYMENT.md).
NOVRSOC_WAZUH_MODE=unconfigured
# WAZUH_URL=https://<manager name>:55000
# WAZUH_USER=novrsoc_api_ro
# WAZUH_PASSWORD=<secret>
# WAZUH_CA_CERT=<PEM>
# WAZUH_INDEXER_URL=https://<indexer name>:9200
# WAZUH_INDEXER_USER=novrsoc_api_ro
# WAZUH_INDEXER_PASSWORD=<secret>
# WAZUH_INDEXER_CA_CERT=<PEM>

# SOAR execution bridge on Server 1 (gate G-S1). Unset = consequential steps fail honestly, nothing executes.
# Files live in ${NOVRSOC_CONFIG_DIR}/files (mounted read-only at /run/novrsoc), owned by uid 10001, mode 0400.
# NOVRSOC_SOAR_BRIDGE_URL=https://<server1 WireGuard address>:8650
# NOVRSOC_SOAR_BRIDGE_KEY_ID=server2-soar
# NOVRSOC_SOAR_BRIDGE_KEY_FILE=/run/novrsoc/server2-soar.key
# NOVRSOC_SOAR_BRIDGE_CA_CERT=/run/novrsoc/bridge-ca.pem

# NHAI: users may queue jobs only once the Server 1 worker is in place (gate G-F2).
NOVRSOC_NHAI_BACKEND=unconfigured

# Alert ownership (release 0018). Collection groups never establish ownership: an agent that carries only these groups
# is quarantined (collection_group_only), whichever organization maps them. Run the read-only attribution audit first:
#   docker compose run --rm migrate python -m app.cli attribution-audit --days 7
NOVRSOC_WAZUH_COLLECTION_GROUPS=default
# The Wazuh manager's own telemetry (agent 000, not a registered syslog/agentless source): platform | quarantine
NOVRSOC_MANAGER_EVENTS=platform

# VMS scanning: disabled (default) | authorized_scopes (production: scopes approved per organization, held to that
# organization's enabled scan policy). Keep disabled until gate G-B2 (a scanner placed where it has a route to the client
# network, an approved scope and policy, a supervised first scan). local_test_targets is development/test only.
NOVRSOC_VMS_SCANNING=disabled
# Not available in production in this release (development/test only):
NOVRSOC_BRAND_RESOLVER=unconfigured
