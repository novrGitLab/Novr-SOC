# ${NOVRSOC_CONFIG_DIR}/backup.env, mode 0600 root:root. Used by the backup and restore-drill jobs (profile "ops").
NOVRSOC_ENV=production
NOVRSOC_DATABASE_URL=postgresql+psycopg://novrsoc_app:<pg_app_password>@postgres:5432/novrsoc
NOVRSOC_PRODUCTION_DATABASE_HOSTS=postgres
NOVRSOC_SESSION_COOKIE_SECURE=true
# pg_dump runs as the schema owner (PostgreSQL 16 client in the image).
NOVRSOC_MIGRATION_DATABASE_URL=postgresql+psycopg://novrsoc_owner:<pg_owner_password>@postgres:5432/novrsoc
# The restore drill creates and drops a disposable database: it needs the superuser connection.
NOVRSOC_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:<pg_superuser_password>@postgres:5432/postgres
