# /etc/novrsoc-v2/vms-greenbone.env (0400, uid 10002). The NovrVMS Greenbone worker (compose service vms-greenbone).
# A DEDICATED Greenbone user, created in gvmd for NovrSOC only (docs/public/DEPLOYMENT.md, "Greenbone"). Never the admin.
GVM_USER=novrsoc_vms
GVM_PASSWORD=<generated by gvmd --create-user; never reused>
# The networks the Greenbone scanner has a route to (comma CIDRs, required): the same declaration as nmap_service.
# Targets outside them are reported no_route and never handed to Greenbone.
VMS_ALLOWED_NETWORKS=<authorized client networks routed from the scanner, e.g. 10.20.0.0/24>
# Targets per Greenbone task (1..256).
VMS_GREENBONE_MAX_TARGETS=16
# Greenbone's built-in object ids (same on every installation); change only if yours differ.
# GVM_CONFIG_ID=daba56c8-73ec-11df-a475-002264764cea      # Full and fast (safe checks on)
# GVM_SCANNER_ID=08b69003-5fc2-4037-a479-93b440211c73     # OpenVAS Default
# GVM_PORT_LIST_ID=33d0cd82-57c6-11e1-8ed1-406186ea4fc5   # All IANA assigned TCP
# GVM_SCAN_TIMEOUT_SECONDS=14400
