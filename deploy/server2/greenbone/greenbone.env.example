# /etc/novrsoc-v2/greenbone.env (0640 root). Settings of the isolated Greenbone stack (deploy/server2/greenbone).
# Pin EVERY image by digest from registry.community.greenbone.net/community/<name>@sha256:<digest> of ONE release, after
# reviewing it. There is no default: compose refuses to start with an unpinned image.
GB_IMAGE_VULNERABILITY_TESTS=registry.community.greenbone.net/community/vulnerability-tests@sha256:<pin>
GB_IMAGE_NOTUS_DATA=registry.community.greenbone.net/community/notus-data@sha256:<pin>
GB_IMAGE_SCAP_DATA=registry.community.greenbone.net/community/scap-data@sha256:<pin>
GB_IMAGE_CERT_BUND_DATA=registry.community.greenbone.net/community/cert-bund-data@sha256:<pin>
GB_IMAGE_DFN_CERT_DATA=registry.community.greenbone.net/community/dfn-cert-data@sha256:<pin>
GB_IMAGE_DATA_OBJECTS=registry.community.greenbone.net/community/data-objects@sha256:<pin>
GB_IMAGE_REPORT_FORMATS=registry.community.greenbone.net/community/report-formats@sha256:<pin>
GB_IMAGE_GPG_DATA=registry.community.greenbone.net/community/gpg-data@sha256:<pin>
GB_IMAGE_REDIS=registry.community.greenbone.net/community/redis-server@sha256:<pin>
GB_IMAGE_PG_GVM=registry.community.greenbone.net/community/pg-gvm@sha256:<pin>
GB_IMAGE_GVMD=registry.community.greenbone.net/community/gvmd@sha256:<pin>
GB_IMAGE_OPENVAS_SCANNER=registry.community.greenbone.net/community/openvas-scanner@sha256:<pin>
GB_IMAGE_MQTT_BROKER=registry.community.greenbone.net/community/mqtt-broker@sha256:<pin>
GB_IMAGE_OSPD_OPENVAS=registry.community.greenbone.net/community/ospd-openvas@sha256:<pin>
GB_IMAGE_NOTUS_SCANNER=registry.community.greenbone.net/community/notus-scanner@sha256:<pin>

# Host directory shared with NovrSOC: gvmd-socket/ (gvmd's GMP socket) and openvas-conf/ (openvas.conf, read-only for
# NovrVMS so it can confirm vhost expansion is off). Same value as NOVRSOC_GREENBONE_RUN_DIR in NovrSOC's .env.
GB_RUN_DIR=/srv/novrsoc-greenbone
# Scanner parallelism and resources (Server 2 also runs NovrSOC's PostgreSQL and API).
GB_MAX_HOSTS=4
GB_MAX_CHECKS=2
GB_SCANNER_MEMORY=3g
GB_SCANNER_CPUS=2.0
# The scanner's egress network. Route ONLY the authorized client networks from it (WireGuard), nothing else.
GB_SCAN_SUBNET=172.30.40.0/24
