# deploy/server2/.env (git-ignored): compose interpolation values. NO SECRETS here.
# The reviewed release: the git short sha the images were built from (docs/public/DEPLOYMENT.md).
NOVRSOC_IMAGE_TAG=<git short sha>
NOVRSOC_CONFIG_DIR=/etc/novrsoc-v2
NOVRSOC_BACKUP_DIR=/var/backups/novrsoc-v2
# Loopback only: host NGINX is the only public listener.
NOVRSOC_API_BIND=127.0.0.1:8000
NOVRSOC_WEB_BIND=127.0.0.1:3210
# Private subnet for the app network (must not overlap WireGuard or the host networks); X-Forwarded-For is trusted
# from this subnet only.
NOVRSOC_APP_SUBNET=172.30.10.0/24
