            "schema": {
              "pattern": "^[a-z_]{3,40}$",
              "title": "Sector",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CniiAccessResponse"
                }
              }
            },
