            "title": "Description",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "network_cidrs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "title": "Network Cidrs",
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "title": "SiteCreate",
        "type": "object"
      },
      "SiteList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Site"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SiteList",
        "type": "object"
