{
  "components": {
    "schemas": {
      "AuditEvent": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "actor_label": {
            "title": "Actor Label",
            "type": "string"
          },
          "actor_type": {
            "enum": [
              "user",
              "service",
              "system"
            ],
            "title": "Actor Type",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "org_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          },
          "outcome": {
            "enum": [
              "success",
              "denied",
              "failure"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "resource_id": {
            "title": "Resource Id",
            "type": "string"
          },
          "resource_type": {
            "title": "Resource Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "occurred_at",
          "org_id",
          "actor_type",
          "actor_id",
          "actor_label",
          "action",
          "outcome",
          "resource_type",
          "resource_id",
          "request_id"
        ],
        "title": "AuditEvent",
        "type": "object"
      },
      "AuditEventList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "AuditEventList",
        "type": "object"
      },
      "CniiAccessResponse": {
        "additionalProperties": false,
        "properties": {
          "active_org_id": {
            "format": "uuid",
            "title": "Active Org Id",
            "type": "string"
          },
          "designation_id": {
            "format": "uuid",
            "title": "Designation Id",
            "type": "string"
          },
          "note": {
            "default": "Access check only. CNII data endpoints are not built in Phase 2.",
            "title": "Note",
            "type": "string"
          },
          "sector": {
            "maxLength": 200,
            "title": "Sector",
            "type": "string"
          }
        },
        "required": [
          "sector",
          "designation_id",
          "active_org_id"
        ],
        "title": "CniiAccessResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable code, e.g. forbidden, validation_error",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "description": "Send back as X-CSRF-Token on POST/PUT/PATCH/DELETE (also set as a cookie)",
            "title": "Csrf Token",
            "type": "string"
          },
          "session": {
            "$ref": "#/components/schemas/SessionInfo"
          }
        },
        "required": [
          "session",
          "csrf_token"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "MembershipSummary": {
        "additionalProperties": false,
