            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "network_cidrs": {
            "items": {
              "type": "string"
            },
            "title": "Network Cidrs",
            "type": "array"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
