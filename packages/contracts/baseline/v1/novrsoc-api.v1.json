              "operations",
              "reporting"
            ],
            "title": "Access Scope",
            "type": "string"
          },
          "org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "role": {
            "enum": [
              "super_admin",
              "soc_manager",
              "analyst",
              "executive",
              "portal_user"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "org",
          "role",
          "access_scope"
        ],
        "title": "MembershipSummary",
        "type": "object"
      },
      "OrgList": {
        "additionalProperties": false,
        "properties": {
          "all_organizations": {
            "description": "True for super_admin: the list is every active organisation",
            "title": "All Organizations",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrgSummary"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "all_organizations"
        ],
        "title": "OrgList",
        "type": "object"
      },
      "OrgSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "OrgSummary",
        "type": "object"
      },
      "ReadinessCheck": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ServiceWhoAmI": {
        "additionalProperties": false,
        "description": "GET /api/v1/service/whoami. Everything here comes from the identity record, nothing from the request.",
        "properties": {
          "identity_id": {
            "format": "uuid",
            "title": "Identity Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "collector",
              "vms_worker",
              "forwarder",
              "email_gateway",
              "backup_agent"
            ],
            "title": "Kind",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "site_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site Id"
          }
        },
        "required": [
          "identity_id",
          "org_id",
          "site_id",
          "kind",
          "scopes"
        ],
        "title": "ServiceWhoAmI",
        "type": "object"
      },
      "SessionInfo": {
        "additionalProperties": false,
        "description": "GET /api/v1/auth/me. Permissions are those of the home role, applied to the active organisation.",
        "properties": {
          "active_org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "cross_org": {
            "title": "Cross Org",
            "type": "boolean"
          },
          "home_org": {
            "$ref": "#/components/schemas/OrgSummary"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipSummary"
            },
            "title": "Memberships",
            "type": "array"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
