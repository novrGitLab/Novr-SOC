{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "user",
            "service",
            "system"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable machine-readable code, e.g. forbidden, validation_error",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z_]{2,40}$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "SiteScopedAddress": {
      "additionalProperties": false,
      "description": "An IP address is only meaningful inside a site: 10.0.0.5 at site A is not 10.0.0.5 at site B.",
      "properties": {
        "hostname": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "site_id": {
          "format": "uuid",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "ip"
      ],
      "title": "SiteScopedAddress",
      "type": "object"
    },
    "Timestamped": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "created_at"
      ],
      "title": "Timestamped",
      "type": "object"
    }
  },
  "$id": "https://contracts.novrsoc.invalid/v1/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovrSOC contracts v1: common",
  "version": "1.0.0"
}
