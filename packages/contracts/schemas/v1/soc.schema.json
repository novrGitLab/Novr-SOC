          "title": "Assignee Label"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "first_response_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Response At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "reference": {
