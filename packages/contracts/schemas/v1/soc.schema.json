        },
        "src_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Src Ip"
        },
        "status": {
          "enum": [
            "new",
            "acknowledged",
            "in_progress",
            "closed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "external_id",
        "rule_id",
        "rule_level",
        "rule_description",
        "severity",
        "agent_id",
        "agent_name",
        "src_ip",
        "mitre_techniques",
        "observed_at",
        "received_at",
        "status"
      ],
      "title": "StoredAlert",
      "type": "object"
    },
    "WazuhAgentRef": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
