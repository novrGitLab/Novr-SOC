          "title": "Resolved At"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sla_resolution_due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sla Resolution Due At"
        },
        "sla_response_due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Consolidation: from the SLA policy when the case was created",
          "title": "Sla Response Due At"
        },
        "sla_state": {
          "default": "no_policy",
          "enum": [
            "met",
            "on_track",
