          "title": "Id",
          "type": "string"
        },
        "mitre_techniques": {
          "items": {
            "type": "string"
          },
          "title": "Mitre Techniques",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "rule_description": {
          "title": "Rule Description",
          "type": "string"
