      ],
      "title": "CaseSummary",
      "type": "object"
    },
    "ConnectorState": {
      "additionalProperties": false,
      "description": "State of one internal connector, as established by the API. Never claims a connection it has not made.",
      "properties": {
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When reachability was last checked; null = never",
          "title": "Checked At"
        },
        "connector": {
          "enum": [
            "wazuh_manager",
            "wazuh_indexer",
            "ollama"
          ],
          "title": "Connector",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 300,
          "title": "Detail",
          "type": "string"
        },
        "state": {
          "enum": [
            "unconfigured",
            "local_fixture",
            "connected",
            "unavailable",
            "error"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "connector",
        "state"
      ],
      "title": "ConnectorState",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
