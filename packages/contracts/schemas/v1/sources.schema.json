{
  "$defs": {
    "LogSourceCreate": {
      "additionalProperties": false,
      "properties": {
        "authorization_reference": {
          "description": "The client authorization (ticket, contract clause) for collecting this device's logs",
          "maxLength": 200,
          "minLength": 3,
          "title": "Authorization Reference",
          "type": "string"
        },
        "device_type": {
          "enum": [
            "firewall",
            "router",
            "switch",
            "linux_server",
            "windows_server",
            "network_appliance",
            "storage",
            "other"
          ],
          "title": "Device Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "host": {
          "default": "",
          "description": "agentless: the host as configured on the Wazuh manager",
          "maxLength": 253,
          "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9.:-]{0,252})$",
          "title": "Host",
          "type": "string"
        },
        "kind": {
          "default": "syslog",
          "enum": [
            "syslog",
            "agentless"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "network": {
          "anyOf": [
            {
              "maxLength": 49,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CIDR the source sits in",
          "title": "Network"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "udp",
            "tcp",
            "tls",
            "ssh"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "site_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "source_ip": {
          "anyOf": [
            {
              "maxLength": 45,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "syslog: the sender address",
          "title": "Source Ip"
        },
        "vendor": {
          "default": "",
          "maxLength": 120,
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "name",
        "device_type",
        "authorization_reference"
      ],
      "title": "LogSourceCreate",
      "type": "object"
    },
    "LogSourceList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/LogSourceView"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "LogSourceList",
      "type": "object"
    },
    "LogSourceReassign": {
      "additionalProperties": false,
      "properties": {
        "org_id": {
          "description": "The organization that now owns the device",
          "format": "uuid",
          "title": "Org Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "org_id",
        "reason"
      ],
      "title": "LogSourceReassign",
      "type": "object"
    },
    "LogSourceRetire": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "LogSourceRetire",
      "type": "object"
    },
