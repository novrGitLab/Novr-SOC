{
  "$defs": {
    "BackupAgentReport": {
      "additionalProperties": false,
      "description": "Backup agent -> API, authenticated by its service identity (replaces the unauthenticated legacy route).",
      "properties": {
        "job": {
          "$ref": "#/$defs/BackupJob"
        },
        "note": {
          "default": "",
          "maxLength": 200,
          "title": "Note",
          "type": "string"
        },
        "report_id": {
          "description": "Client-chosen key; a repeat with the same key returns the first result",
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "job"
      ],
      "title": "BackupAgentReport",
      "type": "object"
    },
    "BackupJob": {
      "additionalProperties": false,
      "properties": {
        "encrypted": {
          "const": true,
          "default": true,
          "title": "Encrypted",
          "type": "boolean"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BackupKind"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "description": "External object-storage location label, never on Server 2",
          "maxLength": 200,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "started_at",
        "status",
        "target"
      ],
      "title": "BackupJob",
      "type": "object"
    },
    "BackupKind": {
      "enum": [
        "logical_dump",
        "wal_archive"
      ],
      "title": "BackupKind",
      "type": "string"
    },
    "CniiAuthorizationCreate": {
      "additionalProperties": false,
      "description": "The record that authorizes monitoring of designated CNII assets. Without an active one, nothing is monitored.",
      "properties": {
        "document_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Sha256"
        },
        "issuing_authority": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Issuing Authority",
          "type": "string"
        },
        "reference": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Reference",
          "type": "string"
        },
        "scope_description": {
          "maxLength": 4000,
          "minLength": 3,
          "title": "Scope Description",
          "type": "string"
        },
        "sectors": {
          "items": {
            "enum": [
              "power",
              "water",
              "ict",
              "finance",
              "health",
              "publicadmin",
              "education",
              "defence",
              "transport",
              "food",
              "safety",
              "industrial",
              "mines"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Sectors",
          "type": "array"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "issuing_authority",
        "scope_description",
        "sectors",
        "valid_from",
        "valid_until"
      ],
      "title": "CniiAuthorizationCreate",
      "type": "object"
    },
    "CniiAuthorizationList": {
      "additionalProperties": false,
