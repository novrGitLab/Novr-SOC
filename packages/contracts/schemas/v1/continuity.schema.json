    "RecoveryPlanCreate": {
      "additionalProperties": false,
      "properties": {
        "backup_source": {
          "enum": [
            "novrsoc_platform_backup",
            "external_provider",
            "manual_procedure"
          ],
          "title": "Backup Source",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "owning_unit": {
          "default": "",
          "maxLength": 200,
          "title": "Owning Unit",
          "type": "string"
        },
        "procedure": {
          "default": "",
          "maxLength": 8000,
          "title": "Procedure",
          "type": "string"
        },
        "provider_name": {
          "default": "",
          "maxLength": 200,
          "title": "Provider Name",
          "type": "string"
        },
        "rpo_minutes": {
          "anyOf": [
            {
              "maximum": 525600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rpo Minutes"
        },
        "rto_minutes": {
          "anyOf": [
            {
              "maximum": 525600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rto Minutes"
        },
        "scope": {
          "maxLength": 4000,
          "minLength": 3,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "name",
        "scope",
        "backup_source"
      ],
      "title": "RecoveryPlanCreate",
      "type": "object"
    },
    "RecoveryPlanList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/RecoveryPlanView"
