        "provider_name": {
          "default": "",
          "maxLength": 200,
          "title": "Provider Name",
          "type": "string"
        },
        "rpo_minutes": {
          "anyOf": [
            {
              "maximum": 525600,
              "minimum": 1,
              "type": "integer"
