{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "user",
            "service",
            "system"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ContinuityOverview": {
      "additionalProperties": false,
      "properties": {
        "completed_requests": {
          "minimum": 0,
          "title": "Completed Requests",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "not_recoverable": {
          "minimum": 0,
          "title": "Not Recoverable",
          "type": "integer"
        },
        "open_requests": {
          "minimum": 0,
          "title": "Open Requests",
          "type": "integer"
        },
        "plans": {
          "minimum": 0,
          "title": "Plans",
          "type": "integer"
        },
        "plans_untested_90d": {
          "minimum": 0,
          "title": "Plans Untested 90D",
          "type": "integer"
        },
        "platform_backups": {
          "$ref": "#/$defs/PlatformBackupState"
        },
        "rpo_met": {
          "minimum": 0,
          "title": "Rpo Met",
          "type": "integer"
        },
        "rpo_missed": {
          "minimum": 0,
          "title": "Rpo Missed",
          "type": "integer"
        },
        "rto_met": {
          "minimum": 0,
          "title": "Rto Met",
          "type": "integer"
        },
        "rto_missed": {
          "minimum": 0,
          "title": "Rto Missed",
          "type": "integer"
        }
      },
      "required": [
        "generated_at",
        "platform_backups",
        "plans",
        "plans_untested_90d",
        "open_requests",
        "completed_requests",
        "not_recoverable",
        "rpo_met",
        "rpo_missed",
        "rto_met",
        "rto_missed"
      ],
      "title": "ContinuityOverview",
      "type": "object"
    },
    "PlatformBackupState": {
      "additionalProperties": false,
      "properties": {
        "last_drill_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Drill At"
        },
        "last_drill_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Drill Status"
        },
        "last_succeeded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Succeeded At"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "visible": {
          "description": "False when the caller may not read platform backup history",
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "visible",
        "note"
      ],
      "title": "PlatformBackupState",
      "type": "object"
    },
    "RecoveryDecision": {
      "additionalProperties": false,
      "description": "assess / approve / reject / not_recoverable, by someone other than the requester (recovery:manage).",
      "properties": {
        "backup_reference": {
          "default": "",
          "maxLength": 300,
          "title": "Backup Reference",
          "type": "string"
        },
        "decision": {
          "enum": [
            "assess",
            "approve",
            "reject",
            "not_recoverable"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "RecoveryDecision",
      "type": "object"
    },
    "RecoveryEventView": {
      "additionalProperties": false,
      "properties": {
        "actor_label": {
          "title": "Actor Label",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "submitted",
            "status_changed",
            "note",
            "evidence",
            "verification"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
