{
  "$defs": {
    "ActionType": {
      "enum": [
        "enrich_iocs",
        "notify_email",
        "notify_ciso",
        "create_task",
        "block_ip",
        "isolate_agent",
        "disable_account"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "user",
            "service",
            "system"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "AiActivityList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AiActivityView"
          },
          "title": "Items",
          "type": "array"
        },
        "note": {
          "default": "AI analysis only. Nothing listed here executed a response action; execution is recorded by the SOAR engine.",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "AiActivityList",
      "type": "object"
    },
    "AiActivityView": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorRef"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "analysis_requested",
            "analysis_completed",
            "analysis_failed",
            "recommendation",
            "proposed_action",
            "review",
            "chat_question",
            "chat_answer",
            "chat_refused"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "nhai_job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nhai Job Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "pending",
            "refused"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "title": "Subject Type",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "id",
        "occurred_at",
        "kind",
        "module",
        "task",
        "subject_type",
        "subject_id",
        "actor",
        "model",
        "outcome",
        "summary"
      ],
      "title": "AiActivityView",
      "type": "object"
    },
    "AlertToCasePromotion": {
      "additionalProperties": false,
      "description": "Analyst (cases:write) promotes stored alerts to a case. Dedupe key: (org, source, source_id).",
      "properties": {
        "alert_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Alert Ids",
          "type": "array"
        },
        "assignee_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignee Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "default": "alert",
          "pattern": "^[a-z0-9_-]{2,40}$",
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "description": "With org and source, the case dedupe key; a repeat returns the existing case",
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "alert_ids",
        "title",
        "severity",
        "source_id"
      ],
      "title": "AlertToCasePromotion",
      "type": "object"
    },
    "ApprovalDecision": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "decided_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        },
        "requested_by": {
          "$ref": "#/$defs/ActorRef",
          "description": "Echoed from the request so self-approval is checked in the contract too"
        }
      },
      "required": [
        "approval_id",
        "decision",
        "reason",
        "decided_by",
        "requested_by"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "ApprovalDecisionRequest": {
      "additionalProperties": false,
      "description": "The human decision. The decider is the signed-in user (never the requester).",
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "ApprovalDecisionRequest",
      "type": "object"
    },
    "ApprovalList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ApprovalView"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ApprovalList",
      "type": "object"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "idempotency_key": {
          "description": "Client-chosen key; a repeat with the same key returns the first result",
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "justification": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Justification",
          "type": "string"
        },
        "requested_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "step_key": {
          "title": "Step Key",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "run_id",
        "step_key",
        "action",
        "target",
        "justification",
        "requested_by"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "ApprovalView": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "approve",
                "reject"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "justification": {
          "title": "Justification",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "requested_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "step_key": {
          "title": "Step Key",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "step_key",
        "action",
        "target",
        "justification",
        "requested_by",
        "expires_at",
        "created_at"
      ],
      "title": "ApprovalView",
      "type": "object"
    },
    "CasePromotionResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "created": {
          "description": "False when an existing case with the same dedupe key was returned",
          "title": "Created",
          "type": "boolean"
        },
        "linked_alert_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Linked Alert Ids",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "created",
        "linked_alert_ids"
      ],
      "title": "CasePromotionResult",
      "type": "object"
    },
    "EmergencyStopRequest": {
      "additionalProperties": false,
      "description": "Turn the organization's emergency stop on or off (soar:manage). Always audited, always with a reason.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 10,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "active",
        "reason"
      ],
      "title": "EmergencyStopRequest",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "dry_run",
        "live"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "message": {
          "maxLength": 200,
          "title": "Message",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "next_attempt_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Attempt At"
        },
        "ownership_rechecked": {
          "description": "Target re-verified as belonging to the organisation at execution time",
          "title": "Ownership Rechecked",
          "type": "boolean"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OutcomeStatus"
        },
        "step_key": {
          "title": "Step Key",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step_key",
        "attempt",
        "status",
        "mode",
        "message",
        "finished_at",
        "ownership_rechecked"
      ],
      "title": "ExecutionOutcome",
      "type": "object"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "description": "The Server 1 bridge's signed answer, verified by the engine before it is stored.",
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "reason": {
          "maxLength": 200,
          "title": "Reason",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "executed",
            "dry_run",
            "rejected",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "status",
        "reason",
        "adapter",
        "executed_at"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "OutcomeStatus": {
      "enum": [
        "succeeded",
        "skipped_not_configured",
        "failed",
        "cancelled",
        "dry_run"
      ],
      "title": "OutcomeStatus",
      "type": "string"
    },
    "PlaybookCreate": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "execution_policy": {
          "$ref": "#/$defs/PlaybookExecutionPolicy",
          "default": {
            "max_runs_per_day": 20,
            "min_case_severity": "low",
            "modes": [
              "dry_run"
            ]
          }
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_-]{1,59}$",
          "title": "Name",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlaybookStep"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "triggers": {
          "$ref": "#/$defs/PlaybookTriggers",
          "default": {
            "min_level": 0,
            "mitre": [],
            "rule_ids": []
          }
        }
      },
      "required": [
        "name",
        "title",
        "steps"
      ],
      "title": "PlaybookCreate",
      "type": "object"
    },
    "PlaybookExecutionPolicy": {
      "additionalProperties": false,
      "description": "Consolidation: how an APPROVED playbook version may run. Live mode still needs the organization's response\npolicy (live_enabled) and a human approval for every consequential step; this policy can only narrow that.",
      "properties": {
        "max_runs_per_day": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Runs Per Day",
          "type": "integer"
        },
        "min_case_severity": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Min Case Severity",
          "type": "string"
        },
        "modes": {
          "default": [
            "dry_run"
          ],
          "items": {
            "$ref": "#/$defs/ExecutionMode"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        }
      },
      "title": "PlaybookExecutionPolicy",
      "type": "object"
    },
    "PlaybookExecutionRequest": {
      "additionalProperties": false,
      "description": "Requested by an analyst/manager for a case. Creates a run in state pending (or awaiting_approval).",
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "idempotency_key": {
          "description": "Client-chosen key; a repeat with the same key returns the first result",
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ExecutionMode",
          "default": "dry_run"
        },
        "playbook_id": {
          "format": "uuid",
          "title": "Playbook Id",
          "type": "string"
        },
        "playbook_version": {
          "minimum": 1,
          "title": "Playbook Version",
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "playbook_id",
        "playbook_version",
        "case_id"
      ],
      "title": "PlaybookExecutionRequest",
      "type": "object"
    },
    "PlaybookList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PlaybookView"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "PlaybookList",
      "type": "object"
    },
    "PlaybookRecommendation": {
      "additionalProperties": false,
      "properties": {
        "matched_on": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "title": "Matched On",
          "type": "array"
        },
        "playbook": {
          "$ref": "#/$defs/PlaybookView"
        },
        "proposed_targets": {
          "additionalProperties": {
            "maxLength": 200,
            "type": "string"
          },
          "default": {},
          "title": "Proposed Targets",
          "type": "object"
        }
      },
      "required": [
        "playbook",
        "matched_on"
      ],
      "title": "PlaybookRecommendation",
      "type": "object"
    },
    "PlaybookReview": {
      "additionalProperties": false,
      "description": "Approve or reject a version that is pending approval. The author can never approve their own version.",
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "note": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "note"
      ],
      "title": "PlaybookReview",
      "type": "object"
    },
    "PlaybookStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "default": {},
          "title": "Parameters",
          "type": "object"
        },
        "step_key": {
          "pattern": "^[a-z0-9_]{2,60}$",
          "title": "Step Key",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "step_key",
        "action"
      ],
      "title": "PlaybookStep",
      "type": "object"
    },
    "PlaybookTriggers": {
      "additionalProperties": false,
      "description": "Deterministic recommendation criteria matched against a case's alerts (never auto-executed).",
      "properties": {
        "min_level": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Min Level",
          "type": "integer"
        },
        "mitre": {
          "default": [],
          "items": {
            "pattern": "^T\\d{4}(\\.\\d{3})?$",
            "type": "string"
          },
          "title": "Mitre",
          "type": "array"
        },
        "rule_ids": {
          "default": [],
          "items": {
            "maxLength": 20,
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "title": "PlaybookTriggers",
      "type": "object"
    },
    "PlaybookValidation": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "errors": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "valid",
        "checked_at"
      ],
      "title": "PlaybookValidation",
      "type": "object"
    },
    "PlaybookVersionList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PlaybookView"
          },
          "title": "Items",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "items"
      ],
      "title": "PlaybookVersionList",
      "type": "object"
    },
    "PlaybookView": {
      "additionalProperties": false,
