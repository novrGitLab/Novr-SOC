        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "idempotency_key": {
          "description": "Client-chosen key; a repeat with the same key returns the first result",
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
