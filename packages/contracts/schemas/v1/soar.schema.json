        "mode": {
          "$ref": "#/$defs/ExecutionMode",
          "default": "dry_run"
        },
        "playbook_id": {
          "format": "uuid",
          "title": "Playbook Id",
          "type": "string"
        },
        "playbook_version": {
          "minimum": 1,
          "title": "Playbook Version",
          "type": "integer"
        }
      },
      "required": [
        "idempotency_key",
        "playbook_id",
        "playbook_version",
        "case_id",
        "justification"
      ],
      "title": "RunCreate",
      "type": "object"
