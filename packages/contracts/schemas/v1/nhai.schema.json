{
  "$defs": {
    "ActionType": {
      "enum": [
        "enrich_iocs",
        "notify_email",
        "notify_ciso",
        "create_task",
        "block_ip",
        "isolate_agent",
        "disable_account"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "user",
            "service",
            "system"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "AlertExplanationRequest": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "format": "uuid",
          "title": "Alert Id",
          "type": "string"
        }
      },
      "required": [
        "alert_id"
      ],
      "title": "AlertExplanationRequest",
      "type": "object"
    },
    "AssetSummaryRequest": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "AssetSummaryRequest",
      "type": "object"
    },
    "BehaviouralInsightSummaryRequest": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/ResourceRef"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "window_start",
        "window_end"
      ],
      "title": "BehaviouralInsightSummaryRequest",
      "type": "object"
    },
    "CaseAssistanceRequest": {
      "additionalProperties": false,
      "description": "Investigation assistance for one case: its linked alerts (authoritative severities), notes, timeline and the\nThreat Insights matches of those alerts. A draft for the analyst; it never changes the case.",
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        }
      },
      "required": [
        "case_id"
      ],
      "title": "CaseAssistanceRequest",
      "type": "object"
    },
    "CaseNoteAcceptance": {
      "additionalProperties": false,
      "description": "An analyst turns a draft into a real case note (possibly edited). Only this writes to the case.",
      "properties": {
        "final_body_markdown": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Final Body Markdown",
          "type": "string"
        },
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/HumanReview"
        }
      },
      "required": [
        "result_id",
        "final_body_markdown",
        "review"
      ],
      "title": "CaseNoteAcceptance",
      "type": "object"
    },
    "CaseNoteDraft": {
      "additionalProperties": false,
      "properties": {
        "body_markdown": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Body Markdown",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "note_kind": {
          "enum": [
            "progress",
            "handover",
            "closure"
          ],
          "title": "Note Kind",
          "type": "string"
        },
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "case_id",
        "note_kind",
        "body_markdown",
        "citations"
      ],
      "title": "CaseNoteDraft",
      "type": "object"
    },
    "CaseNoteDraftRequest": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "description": "Optional: limit the bundle to these case evidence items",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "note_kind": {
          "enum": [
            "progress",
            "handover",
            "closure"
          ],
          "title": "Note Kind",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "note_kind"
      ],
      "title": "CaseNoteDraftRequest",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "description": "Evidence key within one bundle",
          "pattern": "^E[1-9][0-9]{0,3}$",
          "title": "Citation Id",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 1000,
          "title": "Excerpt",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "citation_id",
        "ref",
        "excerpt"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ContextBundle": {
      "additionalProperties": false,
      "description": "What the model sees. Never crosses organisations; sent only to the local inference backend.",
      "properties": {
        "assembled_at": {
          "format": "date-time",
          "title": "Assembled At",
          "type": "string"
        },
        "assembled_for": {
          "description": "The requesting user (audit)",
          "format": "uuid",
          "title": "Assembled For",
          "type": "string"
        },
        "bundle_id": {
          "format": "uuid",
          "title": "Bundle Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "org_id": {
          "format": "uuid",
          "title": "Org Id",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ResourceRef"
        },
        "task": {
          "$ref": "#/$defs/NhaiTask"
        }
      },
      "required": [
        "bundle_id",
        "org_id",
        "task",
        "subject",
        "evidence",
        "assembled_at",
        "assembled_for"
      ],
      "title": "ContextBundle",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One piece of evidence the model may cite. Built server-side from the active organisation only.",
      "properties": {
        "citation_id": {
          "description": "Evidence key within one bundle",
          "pattern": "^E[1-9][0-9]{0,3}$",
          "title": "Citation Id",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 4000,
          "title": "Excerpt",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "redacted": {
          "default": false,
          "description": "True when secrets/PII were removed before inclusion",
          "title": "Redacted",
          "type": "boolean"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "citation_id",
        "ref",
        "excerpt"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FindingExplanationRequest": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        }
      },
      "required": [
        "finding_id"
      ],
      "title": "FindingExplanationRequest",
      "type": "object"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "accept_with_edits",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "$ref": "#/$defs/ActorRef"
        }
      },
      "required": [
        "reviewer",
        "decision",
        "reviewed_at"
      ],
      "title": "HumanReview",
      "type": "object"
    },
    "InvestigationAssistRequest": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "question"
      ],
      "title": "InvestigationAssistRequest",
      "type": "object"
    },
    "ModelOutput": {
      "additionalProperties": false,
      "description": "The JSON shape the model is asked to produce (validated before anything is stored or shown).",
      "properties": {
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "missing_evidence": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "recommendations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "severity_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Statements",
          "type": "array"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "confidence"
      ],
      "title": "ModelOutput",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{12,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "const": "ollama_local",
          "default": "ollama_local",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "NhaiJob": {
      "additionalProperties": false,
      "description": "One asynchronous NHAI request. Inference runs in a separate worker; the API only queues and reads jobs.\n`result` is present only when `status` is `succeeded`; `error_code` explains every other final state.",
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z_]{2,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "queued_at": {
          "format": "date-time",
          "title": "Queued At",
          "type": "string"
        },
        "requested_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/NhaiResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ResourceRef"
        },
        "task": {
          "$ref": "#/$defs/NhaiTask"
        }
      },
      "required": [
        "id",
        "task",
        "subject",
        "status",
        "requested_by",
        "queued_at",
        "deadline_at",
        "attempts"
      ],
      "title": "NhaiJob",
      "type": "object"
    },
    "NhaiJobList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/NhaiJob"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "NhaiJobList",
      "type": "object"
    },
    "NhaiResult": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "missing_evidence": {
          "default": [],
          "description": "Phase 5: evidence that would change the assessment and is not in the bundle. Always includes the gaps found by the deterministic checker, whatever the model said",
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "recommendations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Statements",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "accepted",
            "rejected",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ResourceRef"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/NhaiTask"
        },
        "unsupported_statements_dropped": {
          "default": 0,
          "minimum": 0,
          "title": "Unsupported Statements Dropped",
          "type": "integer"
        },
        "validation_notes": {
          "default": [],
          "description": "Phase 5: every deterministic adjustment made to the model output (confidence cap, dropped statements, severity disagreement), so a reviewer sees exactly what was changed and why",
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "task",
        "subject",
        "model",
        "summary",
        "citations",
        "confidence",
        "generated_at",
        "latency_ms"
      ],
      "title": "NhaiResult",
      "type": "object"
    },
    "NhaiReviewRequest": {
      "additionalProperties": false,
      "description": "A human decision on a succeeded job's draft (nhai:review). The reviewer is the signed-in user.",
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "accept_with_edits",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "decision"
      ],
      "title": "NhaiReviewRequest",
      "type": "object"
    },
    "NhaiTask": {
      "enum": [
        "alert_explanation",
        "behavioural_insight_summary",
        "investigation_assistance",
        "case_note_draft",
        "finding_explanation",
        "asset_summary",
        "chat_answer"
      ],
      "title": "NhaiTask",
      "type": "string"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "citation_ids": {
          "items": {
            "description": "Evidence key within one bundle",
            "pattern": "^E[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        },
        "executes_automatically": {
          "const": false,
          "default": false,
          "title": "Executes Automatically",
          "type": "boolean"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "citation_ids",
        "requires_human_approval"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z_]{2,40}$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "SeverityAssessment": {
      "additionalProperties": false,
      "description": "Phase 5 (additive): the model's evidence-grounded view of an alert's severity. Advisory only: it never\nchanges a stored severity; an analyst decides.",
      "properties": {
        "agrees_with_stored": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agrees With Stored"
        },
        "citation_ids": {
          "items": {
            "description": "Evidence key within one bundle",
            "pattern": "^E[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        },
        "proposed": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Proposed",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "uncertainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "proposed",
        "rationale",
        "citation_ids",
        "uncertainty"
      ],
      "title": "SeverityAssessment",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "items": {
            "description": "Evidence key within one bundle",
            "pattern": "^E[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "citation_ids"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "$id": "https://contracts.novrsoc.invalid/v1/nhai.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovrSOC contracts v1: nhai",
  "version": "1.0.0"
}
