            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Assets"
        },
        "max_users": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
