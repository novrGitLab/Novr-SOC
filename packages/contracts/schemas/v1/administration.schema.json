      "type": "object"
    },
    "BillingPlanCreate": {
      "additionalProperties": false,
      "properties": {
        "billing_interval": {
          "default": "monthly",
          "enum": [
            "monthly",
            "annual"
          ],
          "title": "Billing Interval",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
          "title": "Code",
          "type": "string"
        },
        "currency": {
          "default": "NGN",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "features": {
          "default": [],
          "items": {
            "maxLength": 80,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Features",
          "type": "array"
        },
        "max_assets": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Assets"
        },
        "max_users": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Users"
        },
        "name": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "price_minor": {
          "description": "Price in the currency's minor unit (kobo, cents)",
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Price Minor",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "name",
        "price_minor"
      ],
      "title": "BillingPlanCreate",
      "type": "object"
    },
    "BillingPlanUpdate": {
